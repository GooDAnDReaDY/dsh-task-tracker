{
  "name": "@goodandready-private/dsh-task-tracker",
  "version": "0.2.8",
  "description": "\u0410\u0432\u0442\u043e\u043d\u043e\u043c\u043d\u044b\u0439 \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0439 Todo-\u0438\u043d\u0431\u043e\u043a\u0441 \u0434\u043b\u044f \u0414\u0438: \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0435 JSON-\u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0435 tasks.json, \u0442\u0443\u043b\u044b todo_add / todo_list / todo_done, REST API webServer \u0438 \u043f\u043e\u043b\u043d\u043e\u044d\u043a\u0440\u0430\u043d\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441 TasksScreen.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./lib/client.js"
  },
  "files": [
