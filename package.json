{
  "name": "@goodandready-private/dsh-task-tracker",
  "version": "0.1.4",
  "description": "Todo-инбокс для Ди: тулы todo_add / todo_list / todo_done против локального task-tracker (todo.goodandready.app, /api/tasks, HTTP Basic). Task-board DSH трекером не является — инциденты/кроны/изучение ведутся здесь.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./lib/client.js"
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "lib"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "*"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodandready-private/dsh-task-tracker.git"
  },
  "homepage": "https://github.com/goodandready-private/dsh-task-tracker#readme",
  "bugs": {
    "url": "https://github.com/goodandready-private/dsh-task-tracker/issues"
  }
}
